#!/usr/bin/env bash
# izithread_dump — dump the stacks of ALL threads of the running GitHerd
# process, to diagnose UI freezes. Run it WHILE the window is frozen: the
# "MainThread" stack shows exactly where the main loop is blocked.
#
# The output is printed AND saved to a timestamped file under
# ~/.config/githerd/ (override the directory with IZITHREAD_DUMP_DIR).
#
# py-spy must be installed (`pipx install py-spy` or `pip install py-spy`)
# and needs root to attach — sudo resets PATH, so we pass it through.

set -euo pipefail

if ! command -v py-spy >/dev/null 2>&1; then
    echo "izithread_dump: py-spy not found. Install it once with:" >&2
    echo "    pipx install py-spy   # or: pip install py-spy" >&2
    exit 1
fi

pids="$(pgrep -f githerd || true)"
if [ -z "$pids" ]; then
    echo "izithread_dump: no running githerd process found (pgrep -f githerd)." >&2
    exit 1
fi

if [ "$(printf '%s\n' "$pids" | wc -l)" -gt 1 ]; then
    echo "izithread_dump: several matching processes, using the first:" >&2
    printf '%s\n' "$pids" >&2
fi
pid="$(printf '%s\n' "$pids" | head -n1)"

out_dir="${IZITHREAD_DUMP_DIR:-$HOME/.config/githerd}"
mkdir -p "$out_dir"
out="$out_dir/thread-dump-$(date +%Y%m%d-%H%M%S).txt"

echo "izithread_dump: pid=$pid  →  $out"
sudo env "PATH=$PATH" py-spy dump --pid "$pid" | tee "$out"
